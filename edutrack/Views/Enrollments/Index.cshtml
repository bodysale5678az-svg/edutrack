@model IEnumerable<Enrollment>
@{
    ViewData["Title"] = "كل التسجيلات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-link-45deg text-primary me-2"></i>كل التسجيلات</h3>
        <p class="text-muted small mb-0">ربط الطلاب بالكورسات — الطالب ممكن يكون مسجل في أكتر من كورس</p>
    </div>
    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-journal-code me-1"></i> اختار كورس للتسجيل
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>الطالب</th>
                    <th>الكورس</th>
                    <th>تاريخ التسجيل</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            لا توجد تسجيلات حتى الآن. افتح كورس وضغط "تسجيل طلاب".
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td>@enrollment.Id</td>
                            <td class="fw-bold">@(enrollment.Student?.FullName ?? "-")</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                    @(enrollment.Course?.Title ?? "-")
                                </span>
                            </td>
                            <td class="small">@enrollment.EnrolledOn.ToString("yyyy/MM/dd")</td>
                            <td>
                                <form asp-action="Remove" asp-route-id="@enrollment.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('إلغاء تسجيل هذا الطالب من الكورس؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-x-circle me-1"></i> إلغاء التسجيل
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
