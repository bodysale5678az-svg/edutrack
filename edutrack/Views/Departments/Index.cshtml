@model IEnumerable<Department>
@{
    ViewData["Title"] = "إدارة الأقسام";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-primary me-2"></i>إدارة الأقسام</h3>
        <p class="text-muted small mb-0">الأقسام الأكاديمية اللي بيتوزع عليها المحاضرون</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> إضافة قسم جديد
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info rounded-4 border-0 shadow-sm p-4 text-center">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        لا توجد أقسام حتى الآن. اضغط على "إضافة قسم جديد" للبدء.
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>اسم القسم</th>
                        <th>الوصف</th>
                        <th>عدد المحاضرين</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td>@department.Id</td>
                            <td class="fw-bold">@department.Name</td>
                            <td class="small text-muted">
                                @(string.IsNullOrWhiteSpace(department.Description) ? "-" : department.Description)
                            </td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@(department.Instructors?.Count ?? 0) محاضر</span>
                            </td>
                            <td class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i> تفاصيل
                                </a>
                                <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> تعديل
                                </a>
                                <form asp-action="Delete" asp-route-id="@department.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('هل أنت متأكد من حذف القسم (@department.Name)؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
