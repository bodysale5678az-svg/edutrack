@model StudentDetailsViewModel
@{
    ViewData["Title"] = "ملف الطالب";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-person-badge text-primary me-2"></i>ملف الطالب</h3>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-pencil-square me-1"></i> تعديل البيانات
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-right me-1"></i> عودة للقائمة
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-4">@(Model.Email ?? "بدون بريد")</p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small">رقم الهاتف</div>
                            <div class="fw-semibold" dir="ltr">@Model.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small">الجامعة</div>
                            <div class="fw-semibold">@(Model.University ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small">الكورس الأساسي</div>
                            <div class="fw-semibold">
                                <span class="badge bg-primary rounded-pill px-3 py-2">
                                    <i class="bi bi-star-fill me-1"></i>@(Model.CourseTitle ?? "غير محدد")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small">التسليمات</div>
                            <div class="fw-semibold">@Model.SubmissionCount تسليم</div>
                        </div>
                    </div>
                </div>

                @if (Model.ExtraCourses.Count > 0)
                {
                    <div class="mt-4">
                        <div class="text-muted small mb-2">كورسات إضافية</div>
                        @foreach (var course in Model.ExtraCourses)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2 me-1">
                                <i class="bi bi-plus-lg me-1"></i>@course
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
