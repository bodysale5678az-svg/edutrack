@model EditInstructorViewModel
@{
    ViewData["Title"] = "تعديل بيانات المحاضر";
    var email = ViewBag.Email as string;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square text-primary me-2"></i>تعديل بيانات المحاضر
                </h4>
                <p class="text-muted small mb-0">
                    الحساب: <strong>@(email ?? "غير مرتبط بحساب")</strong>
                </p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingImagePath" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">البيانات</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-semibold"></label>
                            <input asp-for="Specialization" class="form-control" />
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                                <option value="">-- بدون قسم --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">الصورة الشخصية</h6>

                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <div class="mb-3 d-flex align-items-center gap-3">
                            <img src="~/images/instructors/@Model.ExistingImagePath"
                                 alt="الصورة الحالية"
                                 class="rounded-circle object-fit-cover border border-3 border-primary"
                                 style="width: 96px; height: 96px;" />
                            <div>
                                <div class="text-muted small mb-2">الصورة الحالية</div>
                                <button type="submit" form="remove-image-form"
                                        class="btn btn-outline-danger btn-sm rounded-pill">
                                    <i class="bi bi-trash me-1"></i> حذف الصورة
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border rounded-3 small text-muted mb-3">
                            لا توجد صورة لهذا المحاضر بعد.
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="ProfileImage" class="form-label fw-semibold">
                            @(string.IsNullOrEmpty(Model.ExistingImagePath) ? "اختيار صورة" : "تغيير الصورة (اختياري)")
                        </label>
                        <input asp-for="ProfileImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG أو PNG أو WEBP — أقصى حجم 2 ميجابايت.</div>
                        <span asp-validation-for="ProfileImage" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> حفظ التعديلات
                        </button>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <form id="remove-image-form" asp-action="RemoveImage" asp-route-id="@Model.Id" method="post" class="d-none"></form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
